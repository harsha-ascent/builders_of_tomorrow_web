{
  "name": "builders-of-tomorrow-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "dev:api": "wrangler pages dev ./public --port 8788",
    "preview:pages": "npm run build && wrangler pages dev ./dist --port 8788",
    "deploy": "npm run build && wrangler pages deploy ./dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.dev.vars ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file=.dev.vars ./node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "@clerk/backend": "^3.25.0",
    "@clerk/clerk-react": "^5.61.10",
    "@neondatabase/serverless": "^1.2.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "resend": "^6.34.1",
    "three": "^0.186.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
